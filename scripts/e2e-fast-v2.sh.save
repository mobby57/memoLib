```bash
#!/usr/bin/env bash
set -u

BASE="http://localhost:3000"
TIMEOUT=5
FAIL=0

green() { printf '\033[32m✓\033[0m %s\n' "$1"; }
red()   { printf '\033[31m✗\033[0m %s\n' "$1"; }
warn()  { printf '\033[33m⚠\033[0m %s\n' "$1"; }

echo "=== memoLib E2E V2 FAST ==="
echo

# ------------------------------------------------------------
# 1. Serveur
# ------------------------------------------------------------
echo "[1] Serveur"

if ! curl -fsS --max-time "$TIMEOUT" \
  "$BASE/api/health" >/tmp/memolib-health.json 2>/dev/null; then
  red "Serveur/API health KO"
  FAIL=1
else
  green "API health OK"
fi

# ------------------------------------------------------------
# 2. Pages critiques — UNE seule requête chacune
# ------------------------------------------------------------
echo
echo "[2] Pages"

check_page() {
  local url="$1"
  local name="$2"
  local code

  code=$(curl -sS -o /dev/null \
    -w '%{http_code}' \
    --max-time "$TIMEOUT" \
    "$BASE$url" 2>/dev/null || echo "000")

  case "$code" in
    200|3*) green "$name → HTTP $code" ;;
    *)     red   "$name → HTTP $code"; FAIL=1 ;;
  esac
}

check_page "/fr" "Accueil"
check_page "/fr/auth/login" "Login"
check_page "/fr/auth/register" "Register"
check_page "/pricing" "Pricing"

# ------------------------------------------------------------
# 3. API documents
# ------------------------------------------------------------
echo
echo "[3] Auth API / Documents"

code=$(curl -sS -o /tmp/memolib-doc.txt \
  -w '%{http_code}' \
  --max-time "$TIMEOUT" \
  "$BASE/api/documents/upload?dossierId=test" 2>/dev/null || echo "000")

if [ "$code" = "401" ]; then
  green "Documents protégés correctement → HTTP 401"
elif [ "$code" = "429" ]; then
  red "Rate-limit déclenché sur documents"
  FAIL=1
else
  warn "Documents → HTTP $code"
fi

# ------------------------------------------------------------
# 4. Détecter le problème de rate-limit sur session
# IMPORTANT : UNE SEULE requête
# ------------------------------------------------------------
echo
echo "[4] NextAuth session"

code=$(curl -sS -o /tmp/memolib-session.txt \
  -w '%{http_code}' \
  --max-time "$TIMEOUT" \
  "$BASE/api/auth/session" 2>/dev/null || echo "000")

if [ "$code" = "200" ]; then
  green "Session OK → HTTP 200"
elif [ "$code" = "429" ]; then
  red "BUG : /api/auth/session est soumis au rate-limit"
  echo
  cat /tmp/memolib-session.txt 2>/dev/null
  FAIL=1
else
  warn "Session → HTTP $code"
fi

# ------------------------------------------------------------
# 5. Détecter le cycle d'import
# ------------------------------------------------------------
echo
echo "[5] Vérification cycle rate-limit/auth"

if rg -n \
  "from ['\"].*rate-limit|from ['\"].*authOptions|withLoginRateLimit" \
  src/lib/auth src/lib/middleware \
  2>/dev/null | grep -q .; then

  echo "Imports trouvés :"
  rg -n \
    "from ['\"].*rate-limit|from ['\"].*authOptions|withLoginRateLimit" \
    src/lib/auth src/lib/middleware \
    2>/dev/null || true
fi

if grep -Rqs "withLoginRateLimit" \
  src/app/api/auth \
  src/lib/auth \
  src/lib/middleware 2>/dev/null; then

  warn "withLoginRateLimit présent dans la chaîne auth"
fi

# ------------------------------------------------------------
# 6. Chercher spécifiquement le cycle observé dans les logs
# ------------------------------------------------------------
echo
echo "[6] Recherche références circulaires"

if rg -n \
  "authOptions.*rate-limit|rate-limit.*authOptions|\\[\\.\\.\\.nextauth\\].*rate-limit" \
  src 2>/dev/null; then

  red "Références potentiellement circulaires détectées"
  FAIL=1
else
  green "Aucune référence circulaire évidente"
fi

# ------------------------------------------------------------
# 7. Détecter DEBUG NextAuth
# ------------------------------------------------------------
echo
echo "[7] Configuration NextAuth"

if rg -n \
  "debug\s*:\s*true|NEXTAUTH.*DEBUG|AUTH.*DEBUG" \
  src .env* 2>/dev/null | grep -q .; then
  warn "NextAuth DEBUG activé"
else
  green "NextAuth DEBUG non détecté"
fi

# ------------------------------------------------------------
# 8. Résumé
# ------------------------------------------------------------
echo
echo "================================"

if [ "$FAIL" -eq 0 ]; then
  green "V2 FAST : OK"
  echo "Aucun blocage critique détecté."
  exit 0
else
  red "V2 FAST : PROBLÈMES DÉTECTÉS"
  echo
  echo "Priorité :"
  echo "  1. Corriger le cycle rate-limit/auth"
  echo "  2. Ne PAS rate-limiter /api/auth/session"
  echo "  3. Relancer Next.js"
  exit 1
fi
```

