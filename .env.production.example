# ═══ RAILWAY VARIABLES ═══
# Ces variables doivent être ajoutées dans Railway → Service Next.js → Variables

# DATABASE_URL et REDIS_URL sont auto-injectés par Railway
# (créer d'abord les services PostgreSQL et Redis dans ton projet)

# ─── CLERK (production) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── APP ───
NEXT_PUBLIC_APP_URL=https://memolib.space
NODE_ENV=production

# ─── CHIFFREMENT (générer avec openssl rand -hex 32) ───
ENCRYPTION_MASTER_KEY=xxx
OAUTH_STATE_SECRET=xxx
CRON_SECRET=xxx
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=xxx

# ─── IA ───
MISTRAL_API_KEY=sk-xxx
AI_PREFERRED_PROVIDER=mistral

# ─── OPTIONNEL ───
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
