{
  "name": "memolib",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack",
    "dev:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbo",
    "dev:legacy": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect --max-old-space-size=8192 next dev --webpack",
    "prebuild": "node generate-seo.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "postbuild": "node generate-seo.js",
    "build:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build --turbo",
    "build:fast": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_TELEMETRY_DISABLED=1 next build --turbo",
    "start": "next start",
    "start:prod": "cross-env NODE_ENV=production next start -p 3000",
    "preview": "npm run build && npm run start",
    "lint": "eslint src --max-warnings 50",
    "lint:fix": "eslint src --fix",
    "lint:strict": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --exclude='**/integration/**' --exclude='**/e2e/**' --exclude='**/saas-db*' --exclude='**/legifrance*'",
    "test:integration": "cross-env NODE_OPTIONS='--max-old-space-size=4096' jest __testPathPatterns=integration --coverage --passWithNoTests --maxWorkers=2",
    "test:unit": "vitest run tests/unit src/__tests__/lib src/__tests__/domain src/__tests__/utils src/__tests__/types src/__tests__/constants",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:advanced": "node scripts/run-advanced-tests.js",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest --ui",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:scenarios": "npx playwright test tests/e2e/advanced-scenarios.spec.ts",
    "test:performance": "npx playwright test tests/performance/load-testing.spec.ts --project=chromium",
    "test:security": "npx playwright test tests/security/security-advanced.spec.ts --project=chromium",
    "coverage:check": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":30,\"branches\":30,\"functions\":30,\"statements\":30}}'",
    "coverage:report": "jest --coverage --coverageReporters=html && start coverage/lcov-report/index.html",
    "test:smoke": "node scripts/smoke-tests.js",
    "test:health": "node scripts/health-check.js",
    "analyze": "cross-env ANALYZE=true NEXT_TELEMETRY_DISABLED=1 next build",
    "analyze:bundle": "npm run analyze",
    "analyze:maps": "ANALYZE=true npm run build && npx source-map-explorer '.next/static/chunks/*.js' --html --output bundle-report.html",
    "type-check": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsc --noEmit --incremental --skipLibCheck",
    "type-check:safe": "bash scripts/type-check-safe.sh",
    "type-check:changed": "bash scripts/type-check-changed.sh",
    "type-check:diagnostic": "bash scripts/typescript-diagnostic.sh",
    "type-check:watch": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsc --noEmit --watch",
    "clean": "rimraf .next out dist .turbo node_modules/.cache",
    "clean:all": "rimraf .next out dist .turbo node_modules/.cache coverage test-results playwright-report .jest-cache .swc .wrangler .open-next",
    "clean:project": "node -e \"console.log('Use: .\\\\clean-project.ps1 (Windows) or ./clean-project.sh (Linux/Mac)')\"",
    "fresh": "npm run clean && npm install && npm run build",
    "figma": "node scripts/figma-cli.js",
    "figma:sync": "tsx scripts/figma-sync.ts",
    "figma:icons": "tsx scripts/figma-icons.ts",
    "figma:all": "npm run figma:sync && npm run figma:icons",
    "hooks:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install-git-hooks.ps1",
    "commit:snapshot": "powershell -ExecutionPolicy Bypass -File ./scripts/git-snapshot.ps1",
    "commit:snapshot:push": "powershell -ExecutionPolicy Bypass -File ./scripts/git-snapshot.ps1 -Push",
    "tag:version": "powershell -ExecutionPolicy Bypass -File ./scripts/git-tag-version.ps1",
    "tag:version:minor": "powershell -ExecutionPolicy Bypass -File ./scripts/git-tag-version.ps1 -Bump minor",
    "tag:version:major": "powershell -ExecutionPolicy Bypass -File ./scripts/git-tag-version.ps1 -Bump major",
    "tag:version:push": "powershell -ExecutionPolicy Bypass -File ./scripts/git-tag-version.ps1 -Push",
    "prepare": "echo Skipping husky install",
    "postinstall": "prisma generate",
    "db:reset": "node scripts/reset-db.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo-client.ts",
    "db:seed:complete": "tsx prisma/seed-complete.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:optimize": "tsx scripts/db-optimize.ts",
    "db:health": "tsx scripts/db-health.ts",
    "db:benchmark": "tsx scripts/db-benchmark.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "validate": "npm run type-check && npm run lint && npm run test",
    "validate:full": "npm run type-check && npm run lint:strict && npm run test:ci",
    "validate:project": "bash scripts/validate-project.sh",
    "predeploy:vercel": "npm run type-check && npm run build",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:preview": "vercel",
    "deploy:vercel:safe": "npm run predeploy:vercel && vercel build --prod && vercel deploy --prebuilt --prod",
    "deploy:vercel:preview:safe": "npm run predeploy:vercel && vercel build && vercel deploy --prebuilt",
    "email:monitor": "tsx scripts/start-gmail-monitor.ts",
    "email:monitor:integrated": "tsx scripts/email-monitor-integrated.ts",
    "email:stats": "tsx scripts/email-stats.ts",
    "email:export": "tsx scripts/email-export.ts",
    "email:setup": "tsx scripts/email-setup.ts",
    "email:to-workspace": "tsx scripts/email-to-workspace.ts",
    "email:to-workspace:ai": "tsx scripts/email-to-workspace-ai.ts",
    "email:test": "tsx scripts/test-email-processing.ts",
    "email:test:demo": "npm test -- src/__tests__/api/emails/incoming-route.test.ts src/__tests__/api/lawyer/workspace-emails-route.test.ts",
    "email:test:integration-db": "cross-env REAL_DB_TESTS=1 USE_REAL_DB_FOR_TESTS=1 vitest run --config vitest.email-integration.config.mts",
    "email:test:load": "tsx scripts/test-email-ingestion-load.ts",
    "email:thread": "tsx scripts/test-email-threading.ts",
    "gmail:auth": "node scripts/gmail-auth.js",
    "ai:test": "tsx scripts/ai-test.ts",
    "ai:test:ceseda": "tsx scripts/ai-test-ceseda.ts",
    "seed:demo": "tsx prisma/seeds/demo-workspaces.ts",
    "security:scan": "ggshield secret scan path .",
    "security:precommit": "ggshield secret scan pre-commit",
    "security:ci": "ggshield secret scan ci",
    "security:staged": "ggshield secret scan pre-receive",
    "security:install": "ggshield install -m local",
    "security:check": "ggshield secret scan path . --exit-zero",
    "security:audit": "npm audit && node scripts/security-monitor.js",
    "security:fix": "npm audit fix --force",
    "security:report": "node scripts/security-monitor.js",
    "pre-push": "npm run validate",
    "check-quality": "node scripts/check-quality.js",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:audit": "npm audit",
    "deps:unused": "npx depcheck --ignores='@types/*,eslint-*,@testing-library/*'",
    "deps:clean": "npm prune && npm dedupe",
    "dx:setup": "npm install && npx prisma generate && npm run dev",
    "dx:reset": "npm run clean && npm run dx:setup",
    "dx:check": "npm run lint && npm run type-check && npm run test",
    "dx:health": "node -e 'console.log(\"✅ Node:\", process.version)'",
    "monitor:prod": "tsx scripts/monitor-production.ts",
    "monitor:loop": "tsx scripts/monitor-loop.ts",
    "demo:script": "tsx scripts/demo-script.ts",
    "demo:run": "npm run dev",
    "demo:all": "tsx scripts/demo-all-features.ts",
    "api:e2e:onboarding": "powershell -ExecutionPolicy Bypass -File ./scripts/e2e-onboarding.ps1",
    "api:e2e:onboarding:base": "powershell -ExecutionPolicy Bypass -Command \"param([string]$u='http://localhost:8091'); & ./scripts/e2e-onboarding.ps1 -BaseUrl $u\"",
    "demo:client:sarrab:check": "node scripts/validate-demo-client-config.js",
    "demo:client:sarrab:run": "powershell -ExecutionPolicy Bypass -File ./scripts/demo-client-sarrab.ps1",
    "demo:client:sarrab:monitor": "npm run demo:client:sarrab:check && npm run email:monitor:integrated",
    "demo:client:sarrab:full": "powershell -ExecutionPolicy Bypass -File ./scripts/demo-client-sarrab-full.ps1",
    "test:storage": "vitest run src/lib/storage/storageService.smoke.test.ts",
    "requirements:check": "node scripts/check-release-requirements.js",
    "requirements:release": "node scripts/check-release-requirements.js --release"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
