{
  "manifest_version": 3,
  "name": "MemoLib — Assistant Juridique",
  "description": "Analysez vos emails juridiques et créez des dossiers depuis Gmail",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
