import { beforeEach, describe, expect, it, vi } from 'vitest';
import { NextRequest } from 'next/server';

vi.mock('@/lib/clerk-auth', () => ({ auth: vi.fn() }));
vi.mock('@/lib/compliance/gdpr', () => ({
  CONSENT_TYPES: ['essential', 'analytics', 'marketing', 'personalization', 'third_party'],
  CURRENT_PRIVACY_POLICY_VERSION: '2026-10-01',
  DATA_CATEGORIES: ['profile', 'preferences', 'usage'],
  GDPRCompliance: {
    recordConsents: vi.fn(),
    getUserConsents: vi.fn(),
    exportUserData: vi.fn(),
    requestDeletion: vi.fn(),
    cancelDeletion: vi.fn(),
    getDeletionRequests: vi.fn(),
  },
}));
vi.mock('@/lib/logger', () => ({ logger: { error: vi.fn() } }));

import { auth } from '@/lib/clerk-auth';
import { GDPRCompliance } from '@/lib/compliance/gdpr';
import { POST as createConsent } from '@/app/api/compliance/consent/route';
import { POST as createExport } from '@/app/api/compliance/export/route';
import { POST as createDeletion } from '@/app/api/compliance/delete/route';

const mockedAuth = vi.mocked(auth);
const gdpr = GDPRCompliance as unknown as Record<string, ReturnType<typeof vi.fn>>;

describe('compliance routes', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockedAuth.mockResolvedValue({
      isAuthenticated: true,
      clerkUserId: 'clerk-1',
      orgId: null,
      user: {
        id: 'user-1',
        email: 'person@example.test',
        name: 'Person',
        role: 'USER',
        tenantId: 'tenant-1',
      },
    });
  });

  it('accepts anonymous consent (RGPD) and does NOT require auth', async () => {
    const request = new NextRequest('http://localhost/api/compliance/consent', {
      method: 'POST',
      body: JSON.stringify({
        consents: [{ type: 'analytics', granted: false, policyVersion: '2026-10-01' }],
      }),
      headers: { 'Content-Type': 'application/json' },
    });

    const response = await createConsent(request);

    expect(response.status).toBe(200);
    expect(gdpr.recordConsents).not.toHaveBeenCalled();
  });

  it('records only validated, versioned consent against the local user id', async () => {
    // Simule un user connecté pour forcer recordConsents
    const clerk = await import('@clerk/nextjs/server');
    vi.mocked(clerk.auth).mockResolvedValueOnce({
      userId: 'user-1',
      sessionId: 'sess_test',
      orgId: null,
      isAuthenticated: true,
    } as any);

    const response = await createConsent(
      new NextRequest('http://localhost/api/compliance/consent', {
        method: 'POST',
        body: JSON.stringify({
          consents: [{ type: 'analytics', granted: true, policyVersion: '2026-10-01' }],
        }),
      })
    );

    expect(response.status).toBe(200);
    expect(gdpr.recordConsents).toHaveBeenCalledWith('user-1', [
      { type: 'analytics', granted: true, version: '2026-10-01' },
    ]);
  });

  it('rejects unsupported export formats before processing', async () => {
    const response = await createExport(
      new NextRequest('http://localhost/api/compliance/export', {
        method: 'POST',
        body: JSON.stringify({ format: 'csv' }),
      })
    );

    expect(response.status).toBe(400);
    expect(gdpr.exportUserData).not.toHaveBeenCalled();
  });

  it('requires explicit confirmation before creating an erasure request', async () => {
    const response = await createDeletion(
      new NextRequest('http://localhost/api/compliance/delete', {
        method: 'POST',
        body: JSON.stringify({}),
      })
    );

    expect(response.status).toBe(400);
    expect(gdpr.requestDeletion).not.toHaveBeenCalled();
  });
});
