{
  "cSpell.language": "en,fr",
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    "wwwroot/**",
    "public/**",
    ".next/**",
    "obj/**",
    "bin/**",
    "*.zip",
    "*.db",
    "logs/**"
  ],
  "cSpell.words": [
    "memolib",
    "MemoLib",
    "MemoLib.Api",
    "NextAuth",
    "Prisma",
    "ngrok",
    "Playwright",
    "Tampermonkey",
    "Netlify",
    "Vercel",
    "Sentry",
    "Upstash",
    "postcss",
    "tailwind",
    "AIService",
    "AI_SERVICE_URL",
    "AnalysisRequest",
    "AnalysisResponse",
    "Entity",
    "GenerateRequest",
    "GenerateResponse",
    "EmailDraftRequest",
    "EmailDraftResponse",
    "HealthStatus",
    "AIServiceError",
    "OllamaClient",
    "aiService",
    "fetchAI",
    "Ollama",
    "llama3",
    "QuestPDF",
    "ClosedXML",
    "Serilog",
    "SignalR",
    "Twilio",
    "MailKit",
    "FluentValidation",
    "DbContext",
    "EFCore"
  ],
  "cSpell.ignoreRegExpList": [
    "/https?:\\/\\/.*/",
    "/^\\w+\\:\\/\\/.*/",
    "/^[_A-Za-z0-9-]+\\.[_A-Za-z0-9-.]+$/",
    "/^\\d{4}-\\d{2}-\\d{2}/"
  ],
  "cSpell.enableFiletypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "markdown",
    "plaintext",
    "html",
    "css",
    "scss"
  ],
  "cSpell.allowCompoundWords": false,
  "codedeploy.region": "us-east-1",
  "codedeploy.applicationName": "MEMOLIB",
  "codedeploy.isApplicationWorkspace": true
}
