# Snyk policy - Vulnérabilités acceptées (documentées)
# Ces vulns sont dans des dépendances de BUILD uniquement,
# jamais déployées dans le bundle runtime Vercel.

version: v1.25.0
patch: {}
ignore:
  # npm et ses dépendances internes (build-time uniquement)
  npm:
    - reason: "npm n'est utilisé qu'au moment du build. Non déployé en runtime."
      expires: 2027-01-01T00:00:00.000Z
  brace-expansion:
    - reason: "Sous-dépendance de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  picomatch:
    - reason: "Sous-dépendance de npm (node_modules/npm/node_modules/). Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  http-cache-semantics:
    - reason: "Sous-dépendance de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  ip-address:
    - reason: "Sous-dépendance de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  '@npmcli/arborist':
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  pacote:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  libnpmdiff:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  libnpmexec:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  libnpmfund:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  libnpmpack:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  libnpmpublish:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  sigstore:
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  '@sigstore/core':
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  '@sigstore/sign':
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
  '@sigstore/verify':
    - reason: "Dépendance interne de npm. Build-time uniquement."
      expires: 2027-01-01T00:00:00.000Z
