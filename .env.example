# ============================================
# MemoLib - Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================

# --- Base de donnees (OBLIGATOIRE) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/memolib"

# --- Clerk (OBLIGATOIRE) ---
# Créer une instance sur https://dashboard.clerk.com, puis copier les clés
# depuis Configure > Developers > API Keys. Ne jamais exposer CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<your-clerk-publishable-key>
CLERK_SECRET_KEY=sk_test_<your-clerk-secret-key>
# URL publique de l'application, utilisée par les services internes et les redirections.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Coffre-fort documentaire client (OBLIGATOIRE en production) ---
# Chemin vers un volume prive, non expose par le serveur web. Ne pas utiliser
# Vercel Blob : la version integree ne prend en charge que les objets publics.
# VAULT_STORAGE_ROOT=/var/lib/memolib/client-vault

# --- Redis (optionnel, pour rate limiting/cache) ---
REDIS_URL=redis://localhost:6379/1

# --- Upstash Redis (OBLIGATOIRE en production pour rate limiting) ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# --- Cron (OBLIGATOIRE en production) ---
CRON_SECRET=<your-cron-secret>

# --- Mode Demo (mettre 'true' uniquement en dev/staging) ---
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SHOW_DEMO=false

# --- Sentry (recommandé en production) ---
SENTRY_DSN=https://your-key@sentry.io/your-project
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project

# --- Stripe (mode test) ---
STRIPE_SECRET_KEY=sk_test_<your-key>
STRIPE_PUBLISHABLE_KEY=pk_test_<your-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-secret>

# --- Email Gmail (optionnel) ---
EmailMonitor__Username=<your-email@gmail.com>
EmailMonitor__Password=<your-app-password>

# --- Google OAuth (pour connecter Gmail dans l'app) ---
# Créer sur: https://console.cloud.google.com/apis/credentials
# 1. Créer projet → Activer Gmail API
# 2. OAuth consent screen → External → Scopes: gmail.readonly, userinfo.email
# 3. Credentials → OAuth 2.0 Client → Web application
# 4. Redirect URI: https://votre-domaine/api/email/connect/gmail/callback
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>

# --- Microsoft OAuth (pour connecter Outlook dans l'app) ---
# Créer sur: https://portal.azure.com → App registrations
# Redirect URI: https://votre-domaine/api/email/connect/outlook/callback
# API Permissions: Mail.Read (delegated)
MICROSOFT_CLIENT_ID=<your-azure-app-id>
MICROSOFT_CLIENT_SECRET=<your-azure-secret>

# --- IA Cloud (RECOMMANDÉ — aucune installation locale requise) ---
# 
# OPTION 1 (RECOMMANDÉE): Neon AI Gateway — 1 token pour 42+ modèles
# Activé automatiquement dans votre branche Neon. Rien à installer.
# Dashboard Neon → votre projet → AI Gateway → copier les credentials
NEON_AI_GATEWAY_BASE_URL=https://ai.neon.tech/v1
NEON_AI_GATEWAY_TOKEN=<your-neon-ai-token>
NEON_AI_MODEL=mistral-small-latest
# Modèles disponibles: gpt-4o-mini, claude-3-haiku, mistral-small-latest, gemini-2.0-flash, llama-3.1-8b, kimi-k3...
#
# OPTION 2: Providers directs (si pas de Neon AI Gateway)
# Choisir UN provider minimum. Priorité: Mistral (FR/RGPD) > OpenAI > Anthropic
AI_PREFERRED_PROVIDER=mistral
# Mistral (recommandé, hébergement EU) — https://console.mistral.ai/
MISTRAL_API_KEY=<your-mistral-key>
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-key>
# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=<your-anthropic-key>

# Modèles (optionnel, valeurs par défaut raisonnables)
# OPENAI_MODEL=gpt-4o-mini
# MISTRAL_MODEL=mistral-small-latest
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- IA Locale Ollama (optionnel — alternative gratuite, nécessite installation) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# --- Ingestion email monitoring (optionnel) ---
# Seuils de sante (fallback interne si non definis)
EMAIL_INGESTION_HEALTH_MIN_SAMPLE_SIZE=10
EMAIL_INGESTION_DEGRADED_ERROR_RATE_PERCENT=5
EMAIL_INGESTION_CRITICAL_ERROR_RATE_PERCENT=15
EMAIL_INGESTION_DEGRADED_P95_MS=1200
EMAIL_INGESTION_CRITICAL_P95_MS=2500
EMAIL_INGESTION_DEGRADED_SUCCESS_RATE_PERCENT=90
EMAIL_INGESTION_CRITICAL_SUCCESS_RATE_PERCENT=80

# --- Conformité juridique ---
# Région Vercel forcée à Paris (cdg1) dans vercel.json
# HDS requis si données médicales → migrer vers OVH/Scaleway

# --- Ollama IA locale (optionnel) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Azure AD OAuth (gratuit, optionnel) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Azure App Service (dans GitHub Secrets pour CI/CD) ---
# AZURE_CREDENTIALS={"clientId":"...","clientSecret":"...","subscriptionId":"...","tenantId":"..."}

# --- Fly.io (production uniquement, dans GitHub Secrets) ---
# FLY_API_TOKEN=<your-fly-token>
# PRODUCTION_DATABASE_URL=<your-prod-db-url>
# STAGING_DATABASE_URL=<your-staging-db-url>

# --- API Judilibre (Cour de cassation — jurisprudence) ---
# Obtenir un KeyId via https://piste.gouv.fr (gratuit, inscription requise)
# Sélectionner l'API "Judilibre" dans les applications PISTE
JUDILIBRE_KEY_ID=
JUDILIBRE_ENVIRONMENT=sandbox

# --- API Légifrance / PISTE (optionnel — textes de loi + jurisprudence admin) ---
PISTE_SANDBOX_CLIENT_ID=
PISTE_SANDBOX_CLIENT_SECRET=
PISTE_ENVIRONMENT=sandbox

# --- Chiffrement at-rest (OBLIGATOIRE en production) ---
# Clé maîtresse pour chiffrer les emails et données sensibles en BDD (AES-256-GCM)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 caractères hexadécimaux (32 octets) minimum. Conserver dans le gestionnaire
# de secrets du fournisseur de déploiement : perte ou rotation non planifiée = données irrécupérables.
ENCRYPTION_MASTER_KEY=<64-hex-characters>

# --- Sauvegardes chiffrées (optionnel ; exécution opérateur uniquement) ---
# Répertoire privé persistant, permissions 0700, hors du serveur web et hors Git.
# BACKUP_DIR=/var/lib/memolib/backups

# ============================================
# FEATURE FLAGS (Beta)
# Par défaut tous les modules non-core sont désactivés.
# Mettre 'true' pour activer un module.
# ============================================
FEATURE_COMPTABILITE=false
FEATURE_MULTICHANNEL=false
FEATURE_VOICE=false
FEATURE_OCR=false
FEATURE_GITHUB=false
FEATURE_AZURE=false
FEATURE_CALENDAR_SYNC=false
FEATURE_AI_ADVANCED=false
FEATURE_FORMS=false
FEATURE_QUESTIONNAIRE=false
FEATURE_SUPER_ADMIN=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_WORKSPACE_REASONING=false

STORAGE_DRIVER=local

VAULT_STORAGE_ROOT=.vault

# Production Azure Blob:

# STORAGE_DRIVER=azure

# AZURE_STORAGE_ACCOUNT_NAME=

# AZURE_STORAGE_ACCOUNT_KEY=

# AZURE_STORAGE_CONTAINER=memolib
