  @@unique([tenantId, numero])
  @@index([clientId])
  @@index([createdAt])
  @@index([inboxEmail])
  @@index([juridiction, outcome])
  @@index([priorite])
  @@index([statut])
  @@index([teamId])
  @@index([tenantId, createdAt])
  @@index([tenantId, priorite])
  @@index([tenantId, statut])
  @@index([typeDossier, outcome])
}

model TimeEntry {
