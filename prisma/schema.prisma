  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
  @@index([type])
}

model User {
  id               String          @id
  email            String          @unique
  name             String
  password         String
  role             String
  tenantId         String?
  clientId         String?         @unique
  avatar           String?
  phone            String?
  status           String          @default("active")
  lastLogin        DateTime?
  language         String          @default("fr")
  timezone         String          @default("Europe/Paris")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  resetToken       String?
  resetTokenExpiry DateTime?
  emailVerified    DateTime?
  CalendarEvent    CalendarEvent[]
  Document         Document[]
  EmailAccount     EmailAccount[]
  Notification     Notification[]
  TimeEntry        TimeEntry[]
  Client           Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Tenant           Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  DossierMember    DossierMember[]
  TeamMember       TeamMember[]
  UserConsent      UserConsent[]
  UserPreference   UserPreference[]
  DataSubjectRequest DataSubjectRequest[]

  @@index([role])
  @@index([status])
  @@index([tenantId, email])
}

/// Consentement RGPD au niveau utilisateur (cookies, analytics, marketing, etc.),
/// distinct de RGPDConsent qui est scopé par Client (client final du cabinet)
/// et par canal de communication (email/sms/whatsapp).
model UserConsent {
  id            String   @id @default(cuid())
  userId        String
  type          String
  granted       Boolean  @default(true)
  ipAddress     String?
  userAgent     String?
  policyVersion String?
  grantedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([userId, type])
}

/// Préférences utilisateur (clé/valeur JSON) : thème, colonnes, filtres,
/// raccourcis… Distinct de TenantSettings (config cabinet). Chaque utilisateur
/// ne lit/écrit que ses propres préférences (scope userId côté API).
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

/// Demande d'exercice d'un droit par la personne concernée. La résolution est
/// manuelle afin de vérifier les obligations de conservation et le périmètre.
model DataSubjectRequest {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  requestType  String
  status       String   @default("PENDING_REVIEW")
  requestedAt  DateTime @default(now())
  scheduledFor DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId, requestType, status])
  @@index([status, scheduledFor])
}

/// Contrôle d'accès granulaire par dossier ("qui, en plus du RBAC global,
/// peut agir sur CE dossier précis"). Vient en complément de Dossier.responsableId
/// (notion métier de responsable) et du RBAC global (src/lib/auth/rbac.ts),
/// sans les remplacer. Dossier.collaborateurs (champ legacy, non utilisé dans
/// le code) sera déprécié une fois ce modèle adopté par les routes API.
model DossierMember {
  id        String            @id @default(cuid())
  tenantId  String
  dossierId String
  userId    String
  role      DossierMemberRole @default(COLLABORATOR)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  Dossier   Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  User      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dossierId, userId])
  @@index([tenantId])
  @@index([dossierId])
  @@index([userId])
}

enum DossierMemberRole {
  OWNER
  RESPONSIBLE
  ATTORNEY
  COLLABORATOR
  VIEWER
}

/// Équipe au sein d'un cabinet (Tenant). Regroupe des utilisateurs par
/// domaine/pratique (ex: "Droit social", "Contentieux"). Complète le RBAC
/// global : sert de niveau intermédiaire pour l'héritage d'accès aux
/// dossiers (Dossier.teamId), sans remplacer User.role ni le RBAC existant.
model Team {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TeamMember  TeamMember[]
  Dossier     Dossier[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Rôle d'un utilisateur au sein d'une équipe (TeamMember.role) — distinct
/// de User.role (rôle global cabinet). Ex: un ASSOCIE (rôle global) peut être
/// TEAM_LEAD d'une équipe et simple MEMBER d'une autre.
enum TeamMemberRole {
  TEAM_LEAD
  ATTORNEY
  COLLABORATOR
  ASSISTANT
  PARALEGAL
  MEMBER
}

model TeamMember {
  id        String         @id @default(cuid())
  tenantId  String
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  Team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([tenantId])
  @@index([teamId])
  @@index([userId])
}

model WorkflowExecution {
