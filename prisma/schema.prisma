  @@unique([tenantId, email])
  @@index([tenantId, email])
  @@index([tenantId, status])
}

/// Message normalisé multicanal (Email, WhatsApp, SMS, Voice, Slack, Teams...)
/// Persistance pour src/lib/multichannel/channel-service.ts et audit-service.ts
model ChannelMessage {
  id              String                  @id @default(uuid())
  tenantId        String
  externalId      String?
  checksum        String                  @unique
  channel         Channel
  direction       ChannelMessageDirection @default(INBOUND)
  status          ChannelMessageStatus    @default(RECEIVED)
  senderData      Json?
  recipientData   Json?
  subject         String?
  body            String
  bodyHtml        String?
  attachments     Json?
  channelMetadata Json?
  aiSummary       String?
  aiCategory      String?
  aiTags          String[]                @default([])
  aiUrgency       String?
  consentStatus   String                  @default("PENDING")
  auditTrail      Json?
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  clientId        String?
  dossierId       String?
  Tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Client          Client?                 @relation(fields: [clientId], references: [id])
  Dossier         Dossier?                @relation(fields: [dossierId], references: [id])

  @@index([tenantId])
  @@index([channel])
  @@index([status])
  @@index([clientId])
  @@index([dossierId])
  @@index([receivedAt])
}

/// Consentement RGPD par client/canal (src/lib/multichannel/audit-service.ts)
model RGPDConsent {
  id            String    @id @default(uuid())
  clientId      String
  channel       Channel
  purpose       String
  granted       Boolean   @default(false)
  grantedAt     DateTime?
  revokedAt     DateTime?
  expiresAt     DateTime?
  proofDocument String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([channel])
}

model CommunityTemplate {
  id          String   @id
