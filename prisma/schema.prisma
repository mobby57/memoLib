generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIUsageLog {
  id         String   @id
  tenantId   String
  provider   String?
  tokensUsed Int?
  costEur    Float    @default(0)
  operation  String?
  createdAt  DateTime @default(now())
  metadata   String?
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
}

/// Traçabilité des décisions IA (valeur probante) — chaînage par hash.
/// Créé initialement via migration 20260831_add_ai_decision ; ce modèle
/// réaligne le schéma sur les migrations et l'usage code (src/lib/ai/auditService.ts).
model AIDecision {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String?
  entityType     String
  entityId       String
  decisionType   String
  input          Json
  output         Json
  confidence     Float
  source         String
  humanReviewed  Boolean   @default(false)
  reviewedBy     String?
  reviewedAt     DateTime?
  blockchainHash String?
  exportedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([entityId])
  @@index([createdAt])
}

/// Demande d'intake client (formulaire de collecte de données/documents).
/// Origine : Google Sheet (webhook), email, ou saisie manuelle.
///
/// SÉCURITÉ RGPD — données sensibles (justiciables OQTF/asile) :
///  - `encryptedData` contient les réponses du formulaire, chiffrées au niveau
///    applicatif (AES-256-GCM via src/lib/security/encryption.ts). Illisibles
///    sans la clé maître, même avec un accès direct à la base.
///  - `clientEmailEnc` : email client chiffré ; `clientEmailHash` : SHA-256
///    pour déduplication/recherche sans exposer l'email en clair.
///  - Les métadonnées non sensibles (statut, type, complétude) restent en clair
///    pour permettre le requêtage et l'agrégation ("demandes à aider").
model IntakeRequest {
  id                String   @id @default(cuid())
  tenantId          String
  clientId          String?

  type              String   // OQTF | Asile | TitreSejour | ...
  status            String   @default("PENDING") // PENDING|IN_PROGRESS|COMPLETE|NEEDS_HELP
  origin            String   @default("manual")   // googlesheet|email|manual
  sourceRef         String?  // ex: n° de ligne / id de la ligne Google Sheet

  clientEmailEnc    String?  // email chiffré (payload JSON)
  clientEmailHash   String?  // SHA-256 pour dédup/recherche

  encryptedData     String?  // réponses du formulaire, chiffrées (payload JSON)

  requiredFields    Json?    // champs attendus (schéma du formulaire)
  requiredDocuments Json?    // documents attendus
  providedDocuments Json?    // documents fournis (labels cochés)
  uploadedFiles     Json?    // fichiers réellement déposés (métadonnées, réf. de stockage chiffré)
  completeness      Int      @default(0) // 0..100

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, origin, sourceRef])
  @@index([tenantId, status])
  @@index([clientEmailHash])
  @@index([status])
}

model ArchivePolicy {
  id              String        @id
  tenantId        String
  entityType      String
  entityId        String
  status          ArchiveStatus @default(ACTIVE)
  retentionDays   Int
  retentionReason String?
  lastAccessAt    DateTime?
  archiveAt       DateTime?
  deleteAt        DateTime?
  archivedAt      DateTime?
  archivedBy      String?
  deletedAt       DateTime?
  deletedBy       String?
  holdUntil       DateTime?
  holdReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([archiveAt])
  @@index([deleteAt])
  @@index([status])
  @@index([tenantId])
}

model AuditLog {
  id            String      @id
  tenantId      String
  userId        String
  userEmail     String
  userRole      String
  action        AuditAction
  entityType    String
  entityId      String
  oldValue      String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime    @default(now())
  timestampHash String?
  previousLogId String?
  createdAt     DateTime    @default(now())
  hash          String?
  previousHash  String?
  // Champs additifs utilisés par le module multicanal (src/lib/multichannel/audit-service.ts)
  channel       Channel?
  actorType     String?
  actorName     String?
  resourceType  String?
  resourceId    String?
  details       Json?
  clientId      String?
  Tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([entityType, entityId])
  @@index([tenantId])
  @@index([timestamp])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([hash])
  @@index([clientId])
}

model CalendarEvent {
  id             String   @id
