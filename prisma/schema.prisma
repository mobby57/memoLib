  factureId    String?
  category     String    @default("travail")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Client       Client?   @relation(fields: [clientId], references: [id])
  Dossier      Dossier?  @relation(fields: [dossierId], references: [id])
